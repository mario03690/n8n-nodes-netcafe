{
  "name": "n8n-nodes-netcafe",
  "version": "0.1.1",
  "description": "Deterministic tools reachable from mainland China: bank reconciliation without shared keys, Excel read, table diff, duplicate-company detection, US HS/HTS lookup, and real mainland reachability checks. Usable as an AI Agent tool. No API key needed to start.",
  "license": "MIT",
  "homepage": "https://ainetcafe.com/mcp.html",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "reconciliation",
    "excel",
    "xlsx",
    "hs-code",
    "china",
    "ai-agent"
  ],
  "author": {
    "name": "AI NetCafe",
    "email": "mario154156@gmail.com",
    "url": "https://ainetcafe.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario03690/n8n-nodes-netcafe.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/NetCafeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NetCafe/NetCafe.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
